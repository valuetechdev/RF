{"_createdAt":"2024-11-30T13:24:24Z","_updatedAt":"2026-01-09T10:46:01Z","body":[{"children":[{"marks":[],"text":"Marginalskatten baserer seg på summen av de andre typene skatt du betaler, som inntektsskatten, trinnskatten og trygdeavgiften. Summen av alle disse skattene utgjør det som kalles "},{"marks":["em"],"text":"marginalskatt på den siste kronen du tjener"},{"marks":[],"text":"."}],"markDefs":[],"style":"normal"},{"children":[{"marks":[],"text":"«Siste krone» betyr her «den neste, nye kronen du tjener» – altså de kronene som utgjør inntektsøkningen din."}],"markDefs":[],"style":"normal"},{"children":[{"marks":[],"text":"Eksempel på beregning av marginalskatt"}],"markDefs":[],"style":"h2"},{"children":[{"marks":[],"text":"Vi ser for oss en årslønn på 550 000 kr for inntektsåret 2025, og viser her forskjellen på vanlig skatteberegning og beregning av marginalskatt."}],"markDefs":[],"style":"normal"},{"children":[{"marks":[],"text":"Beregning av vanlig skatt"}],"markDefs":[],"style":"h3"},{"children":[{"marks":["strong"],"text":"Bruttoinntekt:"},{"marks":[],"text":" 550 000 kr"}],"markDefs":[],"style":"normal","level":1,"listItem":"bullet"},{"children":[{"marks":["strong"],"text":"Personfradrag:"},{"marks":[],"text":" 108 550 kr"}],"markDefs":[],"style":"normal","level":1,"listItem":"bullet"},{"children":[{"marks":["strong"],"text":"Alminnelig inntekt:"},{"marks":[],"text":" 550 000 kr – 108 550 kr = 441 450 kr"}],"markDefs":[],"style":"normal","level":1,"listItem":"bullet"},{"children":[{"marks":["strong"],"text":"Trygdeavgift:"}],"markDefs":[],"style":"normal"},{"children":[{"marks":[],"text":"Sats: 7,7 prosent"}],"markDefs":[],"style":"normal","level":1,"listItem":"bullet"},{"children":[{"marks":[],"text":"Beregning: 7,7 prosent av 550 000 kr = 42 350 kr"}],"markDefs":[],"style":"normal","level":1,"listItem":"bullet"},{"children":[{"marks":["strong"],"text":"Inntektsskatt på alminnelig inntekt:"}],"markDefs":[],"style":"normal"},{"children":[{"marks":[],"text":"Sats: 22 prosent"}],"markDefs":[],"style":"normal","level":1,"listItem":"bullet"},{"children":[{"marks":[],"text":"Beregning: 22 prosent av 441 450 kr = 97 119 kr"}],"markDefs":[],"style":"normal","level":1,"listItem":"bullet"},{"children":[{"marks":["strong"],"text":"Trinnskatt:"}],"markDefs":[],"style":"normal"},{"children":[{"marks":["strong"],"text":"Trinn 1:"},{"marks":[],"text":" "}],"markDefs":[],"style":"normal","level":1,"listItem":"bullet"},{"children":[{"marks":[],"text":"Inntekt mellom 217 400 kr og 306 050 kr"}],"markDefs":[],"style":"normal","level":2,"listItem":"bullet"},{"children":[{"marks":[],"text":"Sats: 1,7 prosent"}],"markDefs":[],"style":"normal","level":2,"listItem":"bullet"},{"children":[{"marks":[],"text":"Beregning: 1,7 prosent av 88 650 kr (306 050 kr – 217 400 kr) = 1 507,05 kr"}],"markDefs":[],"style":"normal","level":2,"listItem":"bullet"},{"children":[{"marks":["strong"],"text":"Trinn 2:"},{"marks":[],"text":" "}],"markDefs":[],"style":"normal","level":1,"listItem":"bullet"},{"children":[{"marks":[],"text":"Inntekt mellom 306 050 kr og 550 000 kr"}],"markDefs":[],"style":"normal","level":2,"listItem":"bullet"},{"children":[{"marks":[],"text":"Sats: 4 prosent"}],"markDefs":[],"style":"normal","level":2,"listItem":"bullet"},{"children":[{"marks":[],"text":"4 prosent av 243 950 kr (550 000 − 306 050) = 9 758 kr"}],"markDefs":[],"style":"normal","level":2,"listItem":"bullet"},{"children":[{"marks":["strong"],"text":"Total trinnskatt:"},{"marks":[],"text":" 1 507,05 kr + 9 758 = 11 265,05 kr"}],"markDefs":[],"style":"normal","level":1,"listItem":"bullet"},{"children":[{"marks":["strong"],"text":"Total skatt (trygdeavgift, inntektsskatt og trinnskatt):"}],"markDefs":[],"style":"normal"},{"children":[{"marks":[],"text":"42 350 kr + 97 119 kr + 11 265,05 kr = 150 734,05 kr"}],"markDefs":[],"style":"normal"},{"children":[{"marks":["strong"],"text":"Med en brutto årslønn på 550 000 kr blir den gjennomsnittlig skattesats 27,40 prosent."}],"ma