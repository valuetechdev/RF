endrag":[{"children":[{"marks":[],"text":"Feriepenger er penger som utbetales i stedet for vanlig lønn når en ansatt tar ferie. Ifølge Ferieloven skal feriepengene utbetales siste vanlige lønningsdag før ferien, eller senest én uke før arbeidstakeren tar sommerferie. I praksis er det vanlig at feriepengene utbetales samme måned hvert år, som oftest i juni eller juli, på den vanlige lønningsdagen."}],"markDefs":[],"style":"normal"}],"tittel":"feriepenger","slug":{"current":"feriepenger"},"synonymer":null}